# Copy this file to .env for local development. Keep real credentials out of git.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: set all three to create an admin user on startup.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Local PostgreSQL example; use the connection URL supplied by your database host.
DATABASE_URL=postgresql://m4c_user:change-me@localhost:5432/m4c_db

# Optional SMTP settings for password reset email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Movement for Change <noreply@movementforchange.co.ke>"

# Optional key for a future Google Maps integration. The current map uses bundled GeoJSON.
GOOGLE_MAPS_API_KEY=
